{
  "name": "@x-tech-laboratories/x-webview",
  "version": "0.1.0",
  "description": "Runs Electron apps on the system WebKit, drawing through the GPU on devices Chromium cannot use",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-tech-laboratories/X-WebView.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "x-webview": "dist/node/cli.js"
  },
  "exports": {
    "./electron": {
      "types": "./dist/node/electron.d.ts",
      "default": "./dist/node/electron.js"
    },
    "./register": "./dist/node/register.js"
  },
  "scripts": {
    "build": "tsc -b && chmod +x dist/node/cli.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "prepack": "npm run build"
  },
  "dependencies": {
    "esbuild-wasm": "^0.28.2"
  },
  "devDependencies": {
    "@girs/giounix-2.0": "^5.6.0",
    "@girs/gjs": "^5.6.0",
    "@girs/gtk-3.0": "^5.6.0",
    "@girs/webkit2-4.1": "^5.6.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
