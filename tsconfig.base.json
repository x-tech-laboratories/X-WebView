{
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "module": "nodenext",
    "target": "es2024",
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "declaration": true
  }
}
